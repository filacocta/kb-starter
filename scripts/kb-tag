#!/usr/bin/env python3
"""kb-tag — structural tag enrichment for the Obsidian KB.

Adds structural tags derived from frontmatter fields (type, topic, entity-type)
to notes that have `tags: []` or no `tags:` field at all. Notes with ANY
existing non-empty tags are left untouched (idempotent).

Tags derive from:
  type:        → entity, concept, synthesis, source, note, reference, summary, impl-plan, …
  topic:       → the slug verbatim (e.g. cellular-automata, folklore-and-bestiaries)
  entity-type: → person, place, game, text, organization, software, event, creature
  file path    → topic/project slug fallback when no `topic:` field

Usage:
  kb-tag                    dry-run, full KB
  kb-tag --apply            write changes
  kb-tag --scope topics     topics only
  kb-tag --scope projects   projects only
  kb-tag --verbose          per-file breakdown in dry-run

Exit codes:
  0 = clean (nothing to change)
  1 = changes proposed / applied
  2 = error
"""

from __future__ import annotations

import argparse
import importlib.util
import os
import re
import stat
import sys
from pathlib import Path
from typing import Any

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from kb_config import (  # noqa: E402
    KBConfigError,
    iter_markdown,
    read_regular_text,
    resolve_kb_root,
)


def _load_write_guard() -> Any:
    """Load the bundled shared guard without requiring a package install."""
    key = "kb_tag_write_guard"
    module = sys.modules.get(key)
    if module is not None:
        return module
    guard_path = SCRIPT_DIR.parent / "knowledgebase" / "_tools" / "kb-write-guard.py"
    spec = importlib.util.spec_from_file_location(key, guard_path)
    if spec is None or spec.loader is None:
        raise ImportError("cannot load bundled kb-write-guard.py")
    module = importlib.util.module_from_spec(spec)
    sys.modules[key] = module
    spec.loader.exec_module(module)
    return module


_write_guard = _load_write_guard()

# ---------------------------------------------------------------------------
# Notes we never touch.
SKIP_FILENAMES = {
    "_index.md", "_checkpoint.md", "_schema.md", "_rules.md",
    "_dive-queue.md", "_todo.md", "_log.md", "_relink-report.md",
    "_workflow-checklist.md", "_no-emojis.md", "_summary.md",
    "reading-list.md", "LINKS.md", "README.md",
}
SKIP_DIR_PARTS = {".obsidian", ".git", ".trash", "bases", "sources"}
SKIP_PATH_PREFIXES = ("topics/personal-notes/notes/daily/",)

# Structural type → tag. Any unknown type: tag = the type value itself.
TYPE_TAG_MAP: dict[str, str] = {
    "entity": "entity",
    "concept": "concept",
    "synthesis": "synthesis",
    "source": "source",
    "note": "note",
    "reference": "reference",
    "summary": "summary",
    "impl-plan": "impl-plan",
    "meta": "meta",
    "catalog": "catalog",
    "index": "index",
    "prospects": "prospects",
}

# entity-type → tag.
ENTITY_TYPE_TAG_MAP: dict[str, str] = {
    "person": "person",
    "place": "place",
    "game": "game",
    "text": "text",
    "organization": "organization",
    "software": "software",
    "event": "event",
    "creature": "creature",
    "artifact": "artifact",
    "concept": "concept",
    "tool": "tool",
}

# ---------------------------------------------------------------------------
# Frontmatter
# ---------------------------------------------------------------------------

FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.DOTALL)


class _UniqueKeyLoader(yaml.SafeLoader):
    """Reject duplicate YAML keys instead of silently choosing one value."""

    def construct_mapping(self, node, deep=False):  # type: ignore[override]
        mapping = {}
        for key_node, value_node in node.value:
            key = self.construct_object(key_node, deep=deep)
            if key in mapping:
                raise yaml.constructor.ConstructorError(
                    "while constructing a mapping",
                    node.start_mark,
                    f"found duplicate key {key!r}",
                    key_node.start_mark,
                )
            mapping[key] = self.construct_object(value_node, deep=deep)
        return mapping


def split_frontmatter(text: str) -> tuple[dict, str, int]:
    m = FRONTMATTER_RE.match(text)
    if not m:
        return ({}, text, 0)
    raw = m.group(1)
    try:
        fm = yaml.load(raw, Loader=_UniqueKeyLoader) or {}
        if not isinstance(fm, dict):
            fm = {}
    except yaml.YAMLError:
        # A malformed or duplicate frontmatter block is ambiguous ownership
        # metadata.  Do not recover with a permissive regex before a write.
        fm = {}
    return (fm, text[m.end():], m.end())


def extract_existing_tags(fm: dict) -> list[str]:
    raw = fm.get("tags")
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(t) for t in raw if t]
    if isinstance(raw, str):
        return [t.strip() for t in raw.replace(",", " ").split() if t.strip()]
    return []


# ---------------------------------------------------------------------------
# Path filtering
# ---------------------------------------------------------------------------


def is_skipped(path: Path, kb_root: Path) -> bool:
    rel = str(path.relative_to(kb_root))
    parts = Path(rel).parts
    if any(p in SKIP_DIR_PARTS for p in parts):
        return True
    if path.name in SKIP_FILENAMES or path.name.startswith("_"):
        return True
    if path.suffix == ".base":
        return True
    if any(rel.startswith(pfx) for pfx in SKIP_PATH_PREFIXES):
        return True
    return False


# ---------------------------------------------------------------------------
# Tag derivation
# ---------------------------------------------------------------------------


def derive_structural_tags(fm: dict, path: Path, kb_root: Path) -> list[str]:
    tags: list[str] = []

    # type tag
    type_val = str(fm.get("type", "")).strip()
    if type_val:
        tag = TYPE_TAG_MAP.get(type_val, type_val)
        if tag:
            tags.append(tag)

    # topic tag — from frontmatter or path
    topic_val = str(fm.get("topic", "")).strip()
    if not topic_val:
        # derive from path: topics/<slug>/... or projects/<slug>/...
        rel_parts = path.relative_to(kb_root).parts
        if len(rel_parts) >= 2 and rel_parts[0] in ("topics", "projects"):
            topic_val = rel_parts[1]
    if topic_val and topic_val not in tags:
        tags.append(topic_val)

    # entity-type tag
    entity_type = str(fm.get("entity-type", "")).strip()
    if entity_type:
        tag = ENTITY_TYPE_TAG_MAP.get(entity_type, entity_type)
        if tag and tag not in tags:
            tags.append(tag)

    return tags


# ---------------------------------------------------------------------------
# Tag application
# ---------------------------------------------------------------------------


def apply_tags(text: str, body_start: int, new_tags: list[str]) -> str:
    """Insert or replace the tags: field in frontmatter."""
    if not new_tags:
        return text
    fm_text = text[:body_start]
    body = text[body_start:]

    tag_line_m = re.search(r"(?m)^tags:\s*.*$", fm_text)
    inline = ", ".join(new_tags)

    if tag_line_m is None:
        # No tags: line — insert before closing ---
        close_m = re.search(r"\n---\s*\n", fm_text)
        if close_m is None:
            return text
        insert_at = close_m.start() + 1
        new_fm = fm_text[:insert_at] + f"tags: [{inline}]\n" + fm_text[insert_at:]
        return new_fm + body

    # Replace the existing (empty) tags line with populated one.
    line_start = tag_line_m.start()
    line_end = fm_text.find("\n", line_start)
    if line_end == -1:
        line_end = len(fm_text)
    new_fm = fm_text[:line_start] + f"tags: [{inline}]" + fm_text[line_end:]
    return new_fm + body


def verify_yaml(text: str) -> bool:
    m = FRONTMATTER_RE.match(text)
    if not m:
        return True
    try:
        result = yaml.load(m.group(1), Loader=_UniqueKeyLoader)
        return isinstance(result, dict)
    except yaml.YAMLError:
        return False


def _file_identity(path: Path) -> tuple[int, int, int, int]:
    """Return an lstat identity suitable for the plan/recheck boundary."""
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise KBConfigError(f"note is not a singly-linked regular file: {path}")
    return (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_size)


def _ownership_reason(path: Path, fm: dict, kb_root: Path | None = None) -> str | None:
    """Return a refusal reason for immutable sources or human-owned notes."""
    relative_parts = path.relative_to(kb_root).parts if kb_root is not None else path.parts
    if "sources" in relative_parts:
        return "immutable source path"
    if str(fm.get("type", "")).strip().lower() == "source":
        return "immutable source note"
    if fm.get("author") != "kb-bot":
        return "note is not unambiguously owned by kb-bot"
    return None


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def collect_files(kb_root: Path, scope: str) -> list[Path]:
    dirs: list[str] = []
    if scope in ("all", "topics"):
        dirs.append("topics")
    if scope in ("all", "projects"):
        dirs.append("projects")
    out = [p for p in iter_markdown(kb_root, dirs) if not is_skipped(p, kb_root)]
    return sorted(out)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--apply", action="store_true",
                        help="Write changes (default: dry-run)")
    parser.add_argument("--scope", choices=["all", "topics", "projects"],
                        default="all",
                        help="Which subtree to process (default: all)")
    parser.add_argument("--verbose", action="store_true",
                        help="Show per-file tag assignments in dry-run")
    parser.add_argument("--kb-root", default=None,
                        help="Explicit KB vault root (otherwise use portable config resolution)")
    args = parser.parse_args()

    try:
        kb_root = resolve_kb_root(args.kb_root)
    except KBConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    try:
        files = collect_files(kb_root, args.scope)
    except (KBConfigError, OSError) as exc:
        print(f"error: cannot scan KB: {exc}", file=sys.stderr)
        return 2
    print(f"Scanning {len(files)} files (scope={args.scope}, mode={'apply' if args.apply else 'dry-run'})…",
          file=sys.stderr)

    # Keep the first read and its identity as a plan.  Apply mode re-reads
    # every candidate while holding the shared KB lock before publishing it.
    needs_tags: list[tuple[Path, list[str], tuple[int, int, int, int]]] = []
    skipped_already_tagged = 0
    skipped_unowned = 0
    skipped_sources = 0

    for path in files:
        try:
            text = read_regular_text(path)
            identity = _file_identity(path)
        except (KBConfigError, OSError):
            continue

        fm, _body, body_start = split_frontmatter(text)
        if body_start == 0:
            continue  # no frontmatter at all

        ownership = _ownership_reason(path, fm, kb_root)
        if ownership:
            if ownership.startswith("immutable source"):
                skipped_sources += 1
            else:
                skipped_unowned += 1
            if args.verbose:
                print(f"  skip {path.relative_to(kb_root)} — {ownership}")
            continue

        # A non-list/non-string tags value is malformed ownership-adjacent
        # metadata; do not normalize it as a side effect of tag enrichment.
        raw_tags = fm.get("tags")
        if raw_tags is not None and not isinstance(raw_tags, (list, str)):
            if args.verbose:
                print(f"  skip {path.relative_to(kb_root)} — malformed tags field")
            continue

        existing = extract_existing_tags(fm)
        if existing:
            skipped_already_tagged += 1
            continue

        derived = derive_structural_tags(fm, path, kb_root)
        if not derived:
            continue

        needs_tags.append((path, derived, identity))
        if args.verbose and not args.apply:
            print(f"  {path.relative_to(kb_root)}")
            print(f"    + {derived}")

    written = 0
    if args.apply and needs_tags:
        try:
            with _write_guard.write_lock(kb_root, nonblocking=True):
                for path, derived, planned_identity in needs_tags:
                    rel = str(path.relative_to(kb_root))
                    try:
                        current_identity = _file_identity(path)
                        if current_identity != planned_identity:
                            print(f"warn: concurrent modification, skipping {rel}", file=sys.stderr)
                            continue
                        # Re-read under the lock.  This protects ownership and
                        # source checks even if a cooperative writer changed
                        # metadata after the initial dry-run-style scan.
                        current_text = _write_guard.regular_text(path)
                        read_identity = _file_identity(path)
                        if read_identity != current_identity:
                            print(f"warn: note changed during re-read, skipping {rel}", file=sys.stderr)
                            continue
                        current_fm, _body, current_body_start = split_frontmatter(current_text)
                        if current_body_start == 0:
                            print(f"warn: frontmatter changed, skipping {rel}", file=sys.stderr)
                            continue
                        ownership = _ownership_reason(path, current_fm, kb_root)
                        if ownership:
                            print(f"warn: {ownership}, skipping {rel}", file=sys.stderr)
                            continue
                        current_raw_tags = current_fm.get("tags")
                        if current_raw_tags is not None and not isinstance(current_raw_tags, (list, str)):
                            print(f"warn: malformed tags field, skipping {rel}", file=sys.stderr)
                            continue
                        if extract_existing_tags(current_fm):
                            print(f"note: tags appeared while planning, skipping {rel}", file=sys.stderr)
                            continue
                        candidate = apply_tags(current_text, current_body_start, derived)
                        if not verify_yaml(candidate):
                            print(f"warn: YAML would break in {rel}; skipped", file=sys.stderr)
                            continue
                        _write_guard.atomic_write(
                            path, candidate, prefix=".kb-tag-"
                        )
                        written += 1
                    except (_write_guard.WriteGuardError, KBConfigError, OSError) as exc:
                        print(f"warn: safe write skipped {rel}: {exc}", file=sys.stderr)
        except (_write_guard.WriteGuardError, KBConfigError, OSError) as exc:
            print(f"error: could not acquire KB write guard: {exc}", file=sys.stderr)
            return 2

    # Summary
    print(f"\nResults:")
    print(f"  Files scanned:          {len(files)}")
    print(f"  Already tagged (skip):  {skipped_already_tagged}")
    print(f"  Immutable sources (skip): {skipped_sources}")
    print(f"  Unowned/ambiguous (skip): {skipped_unowned}")
    print(f"  Need structural tags:   {len(needs_tags)}")
    if args.apply:
        print(f"  Tags written:           {written}")
        if written:
            # Refresh the frontmatter cache so kb-search stays current
            import subprocess
            print("Refreshing kb-index cache…", file=sys.stderr)
            index_script = Path(__file__).resolve().with_name("kb-index")
            subprocess.run(
                [sys.executable, str(index_script), "--update", "--kb-root", str(kb_root)],
                check=False,
            )
    else:
        print(f"  (dry-run — pass --apply to write)")

    if not args.verbose and not args.apply and needs_tags:
        print(f"\nTop 20 files that would be tagged:")
        for path, tags, _identity in needs_tags[:20]:
            rel = str(path.relative_to(kb_root))
            print(f"  {rel}")
            print(f"    + {tags}")
        if len(needs_tags) > 20:
            print(f"  … and {len(needs_tags) - 20} more (use --verbose for full list)")

    return 1 if needs_tags else 0


if __name__ == "__main__":
    sys.exit(main())
