#!/bin/sh
'''exec' python3 "$0" "$@"
' '''
"""Build a read-only handoff plan for content-tagging KB stubs.

This command inventories eligible notes and prints a bounded plan for the
user's active agent harness to review.  It never edits the KB, starts a model,
selects a provider, or invokes another CLI.  A note is eligible only when it
is an exact ``author: kb-bot`` note, has a non-source type, contains the
standard stub marker, and has at most three structural tags.

Usage:
  kb-tag-content                         plan all topic stubs
  kb-tag-content --topic cellular-automata
  kb-tag-content --json                   machine-readable handoff packet
  kb-tag-content --limit 50               cap the printed candidate list

``--dry-run`` is retained as a compatibility alias; planning is always
read-only now.
"""

import argparse
import json
import os
import re
import sys
from dataclasses import asdict, dataclass
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from kb_config import (  # noqa: E402
    KBConfigError,
    iter_markdown,
    read_regular_text,
    resolve_kb_root,
    validate_topic_slug,
)


FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.DOTALL)
SKIP_FILENAMES = {
    "_index.md",
    "_summary.md",
    "_checkpoint.md",
    "_schema.md",
    "_rules.md",
    "_dive-queue.md",
    "_todo.md",
    "_log.md",
    "reading-list.md",
    "LINKS.md",
    "README.md",
}
SKIP_DIR_PARTS = {".obsidian", ".git", ".trash", "bases", "sources"}


class _UniqueKeyLoader(yaml.SafeLoader):
    """Keep malformed or duplicate metadata out of the handoff plan."""

    def construct_mapping(self, node, deep=False):  # type: ignore[override]
        mapping = {}
        for key_node, value_node in node.value:
            key = self.construct_object(key_node, deep=deep)
            if key in mapping:
                raise yaml.constructor.ConstructorError(
                    "while constructing a mapping",
                    node.start_mark,
                    f"found duplicate key {key!r}",
                    key_node.start_mark,
                )
            mapping[key] = self.construct_object(value_node, deep=deep)
        return mapping


@dataclass(frozen=True)
class Candidate:
    path: str
    topic: str
    title: str
    note_type: str
    tags: list[str]
    reason: str


def parse_frontmatter(text: str) -> tuple[dict, str] | None:
    match = FRONTMATTER_RE.match(text)
    if match is None:
        return None
    try:
        metadata = yaml.load(match.group(1), Loader=_UniqueKeyLoader) or {}
    except yaml.YAMLError:
        return None
    if not isinstance(metadata, dict):
        return None
    return metadata, text[match.end():]


def _topic_dirs(root: Path, topic: str | None) -> list[str]:
    topics_dir = root / "topics"
    if topic is not None:
        validate_topic_slug(topic, root)
        return [(Path("topics") / topic).as_posix()]
    if not topics_dir.is_dir() or topics_dir.is_symlink():
        return []
    names: list[str] = []
    for entry in sorted(topics_dir.iterdir(), key=lambda item: item.name):
        if entry.name.startswith(".") or entry.is_symlink() or not entry.is_dir():
            continue
        names.append(entry.name)
    return [(Path("topics") / name).as_posix() for name in names]


def _is_candidate(path: Path, root: Path) -> Candidate | None:
    relative = path.relative_to(root)
    if (
        path.name in SKIP_FILENAMES
        or path.name.startswith("_")
        or any(part in SKIP_DIR_PARTS for part in relative.parts)
        or len(relative.parts) < 3
        or relative.parts[0] != "topics"
    ):
        return None
    try:
        parsed = parse_frontmatter(read_regular_text(path))
    except (KBConfigError, OSError):
        return None
    if parsed is None:
        return None
    metadata, body = parsed
    if metadata.get("author") != "kb-bot":
        return None
    note_type = str(metadata.get("type", "")).strip()
    if not note_type or note_type.lower() == "source":
        return None
    if "This is a stub" not in body:
        return None
    raw_tags = metadata.get("tags", [])
    if raw_tags is None:
        raw_tags = []
    if not isinstance(raw_tags, list):
        return None
    if any(isinstance(tag, (dict, list, tuple, set)) for tag in raw_tags):
        return None
    tags = [str(tag).strip() for tag in raw_tags if str(tag).strip()]
    if len(tags) > 3:
        return None
    topic = str(metadata.get("topic", "")).strip() or relative.parts[1]
    title = str(metadata.get("title", "")).strip() or path.stem.replace("-", " ").title()
    return Candidate(
        path=relative.as_posix(),
        topic=topic,
        title=title,
        note_type=note_type,
        tags=tags,
        reason="stub with structural-only tags; review content tags in active harness",
    )


def find_candidates(root: Path, topic: str | None = None) -> list[Candidate]:
    candidates: list[Candidate] = []
    for relative_dir in _topic_dirs(root, topic):
        for path in iter_markdown(root, (relative_dir,)):
            candidate = _is_candidate(path, root)
            if candidate is not None:
                candidates.append(candidate)
    candidates.sort(key=lambda candidate: (candidate.topic, candidate.path))
    return candidates


def _active_harness() -> str:
    configured = os.environ.get("KB_AGENT", "").strip().lower()
    return configured if configured in {"claude", "codex"} else "your active harness"


def render_text(root: Path, candidates: list[Candidate], *, topic: str | None,
                limit: int, dry_run: bool) -> str:
    shown = candidates[:limit] if limit > 0 else candidates
    harness = _active_harness()
    lines = [
        "KB content-tagging plan (read-only)",
        f"Candidates: {len(candidates)}" + (f"; showing {len(shown)}" if len(shown) != len(candidates) else ""),
        "",
        "Handoff: review the candidates below in " + harness + ".",
        "This command does not edit notes or invoke a model, provider, or external CLI.",
    ]
    if topic:
        lines.append(f"Scope: topic {topic}")
    if dry_run:
        lines.append("Compatibility flag --dry-run accepted; planning is always read-only.")
    lines.extend(["", "Candidates:"])
    if not shown:
        lines.append("(none)")
    else:
        for candidate in shown:
            tags = ", ".join(candidate.tags) or "(none)"
            lines.append(f"- `{candidate.path}` — {candidate.title}")
            lines.append(f"  topic: {candidate.topic}; type: {candidate.note_type}; tags: {tags}")
            lines.append(f"  reason: {candidate.reason}")
    if len(shown) < len(candidates):
        lines.append(f"… {len(candidates) - len(shown)} more; increase --limit to include them.")
    return "\n".join(lines)


def render_json(root: Path, candidates: list[Candidate], *, topic: str | None,
                limit: int) -> str:
    shown = candidates[:limit] if limit > 0 else candidates
    return json.dumps(
        {
            "read_only": True,
            "kb_root": str(root),
            "scope_topic": topic,
            "active_harness": _active_harness(),
            "handoff": "Review these candidates in the active harness; no model/provider/CLI was invoked.",
            "candidate_count": len(candidates),
            "candidates": [asdict(candidate) for candidate in shown],
        },
        indent=2,
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--topic", help="restrict the plan to one validated topic slug")
    parser.add_argument("--kb-root", default=None, help="explicit KB root")
    parser.add_argument("--limit", type=int, default=0, help="maximum candidates to print (0 = all)")
    parser.add_argument("--json", action="store_true", help="emit JSON handoff packet")
    parser.add_argument("--dry-run", action="store_true", help="compatibility alias; plan is always read-only")
    args = parser.parse_args()
    if args.limit < 0:
        parser.error("--limit must be zero or greater")

    try:
        root = resolve_kb_root(args.kb_root)
        candidates = find_candidates(root, args.topic)
    except KBConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(render_json(root, candidates, topic=args.topic, limit=args.limit))
    else:
        print(render_text(root, candidates, topic=args.topic, limit=args.limit, dry_run=args.dry_run))
    return 0


if __name__ == "__main__":
    sys.exit(main())
