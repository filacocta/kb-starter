#!/usr/bin/env python3
"""kb-topic-audit — detect potentially misfiled notes and cross-topic borrowing.

Two complementary passes:

  FORWARD  (default, --forward)
    For each note, compare its tags against every topic's tag profile.
    If another topic scores significantly higher than the note's declared
    topic, flag it as a reassignment candidate.

    Score = sum of IDF(tag) for each tag the note shares with a topic's
    profile (tags pooled from _summary.md + all notes in that topic).
    Tags shared by many topics carry low IDF weight; rare tags carry high
    weight. A note is flagged when the top foreign topic score exceeds
    the home topic score by more than --threshold AND the foreign topic
    matches at least --min-hits tags.

  REVERSE  (default, --reverse)
    For each note, count inbound wikilinks by topic. If more than half of a
    note's inbound links come from a single foreign topic (and there are at
    least --min-links of them), flag the note as a candidate for relocation
    or strong cross-linking.

Both modes produce ranked tables with confidence scores. Neither mode modifies
any files — output only.

Usage:
    kb-topic-audit                        both modes, all topics
    kb-topic-audit --forward              forward pass only
    kb-topic-audit --reverse              reverse pass only
    kb-topic-audit --topic mysticism      scope to one topic
    kb-topic-audit --min-hits 2           require ≥2 tag overlaps (default 1)
    kb-topic-audit --threshold 0.4        min score gap to flag (default 0.2)
    kb-topic-audit --min-links 2          min inbound cross-links for reverse (default 2)
    kb-topic-audit --json                 JSON output
    kb-topic-audit --md                   Markdown output

Exit codes:
    0 = no candidates found
    1 = candidates found (not errors — just suggestions)

Env:
    KB_ROOT  Override KB path. Default: reads ~/.claude/kb-config.md or
             ~/Documents/vault/knowledgebase
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
from collections import defaultdict
from dataclasses import dataclass, asdict, field
from pathlib import Path

WIKILINK_RE = re.compile(r"!?\[\[([^\]\n|]+)(?:\|[^\]\n]+)?\]\]")
FRONTMATTER_RE = re.compile(r"\A---\n(.*?)\n---\n", re.DOTALL)
FENCED_CODE_RE = re.compile(r"^```.*?^```", re.DOTALL | re.MULTILINE)
INLINE_CODE_RE = re.compile(r"`[^`\n]+`")

# Notes in these paths are structural — exempt from topic analysis
INFRA_FRAGMENTS = (
    "_summary.md", "_index.md", "_log.md", "_schema.md", "_rules.md",
    "_checkpoint.md", "_dive-queue.md", "_todo.md", "_todos.md",
    "reading-list.md", "README.md",
)
INFRA_PREFIXES = ("readinglist/", "clippings/")
INFRA_PATTERNS = ("_Index_of_",)


# ---------------------------------------------------------------------------
# KB root resolution (mirrors kb-lint)
# ---------------------------------------------------------------------------

def resolve_kb_root() -> Path:
    env_val = os.environ.get("KB_ROOT")
    if env_val:
        return Path(os.path.expanduser(env_val)).resolve()
    kb_config = Path.home() / ".claude/kb-config.md"
    if kb_config.exists():
        for line in kb_config.read_text().splitlines():
            line = line.strip()
            if line.startswith("KB_ROOT:") or line.startswith("KB_ROOT="):
                val = (line.split(":", 1)[-1] if ":" in line else line.split("=", 1)[-1])
                val = val.strip().strip('"').strip("'")
                if val:
                    return Path(os.path.expanduser(val)).resolve()
    return (Path.home() / "Documents/vault/knowledgebase").resolve()


# ---------------------------------------------------------------------------
# Frontmatter parser (mirrors kb-lint — no pyyaml dependency)
# ---------------------------------------------------------------------------

def parse_frontmatter(text: str) -> tuple[dict, str]:
    m = FRONTMATTER_RE.match(text)
    if not m:
        return {}, text
    raw = m.group(1)
    body = text[m.end():]
    fm: dict = {}
    current_key: str | None = None
    for line in raw.split("\n"):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line.startswith(" ") or line.startswith("\t"):
            if current_key and isinstance(fm.get(current_key), list):
                v = line.strip().lstrip("- ").strip()
                if v:
                    fm[current_key].append(v)
            continue
        if ":" in line:
            k, _, v = line.partition(":")
            k = k.strip()
            v = v.strip()
            current_key = k
            if not v:
                fm[k] = []
            elif v.startswith("[") and v.endswith("]"):
                inner = v[1:-1].strip()
                fm[k] = [x.strip().strip("'\"") for x in inner.split(",") if x.strip()]
            elif v.startswith('"') and v.endswith('"'):
                fm[k] = v[1:-1]
            elif v.startswith("'") and v.endswith("'"):
                fm[k] = v[1:-1]
            else:
                fm[k] = v
    return fm, body


def strip_code(text: str) -> str:
    def blank(m):
        return "".join("\n" if c == "\n" else " " for c in m.group(0))
    text = FENCED_CODE_RE.sub(blank, text)
    text = INLINE_CODE_RE.sub(blank, text)
    return text


# ---------------------------------------------------------------------------
# File loading
# ---------------------------------------------------------------------------

@dataclass
class FileMeta:
    path: Path
    rel: str          # relative to KB root
    topic: str        # from frontmatter, or inferred from path
    fm_topic: str     # raw frontmatter value (may be empty)
    tags: list[str]
    note_type: str
    body: str


def _is_infra(rel: str) -> bool:
    basename = rel.split("/")[-1]
    if any(basename == f for f in INFRA_FRAGMENTS):
        return True
    if any(p in basename for p in INFRA_PATTERNS):
        return True
    if any(rel.startswith(p) for p in INFRA_PREFIXES):
        return True
    return False


def _topic_from_path(rel: str) -> str:
    """Infer topic slug from path like topics/<slug>/notes/..."""
    parts = rel.split("/")
    if len(parts) >= 2 and parts[0] == "topics":
        return parts[1]
    if len(parts) >= 2 and parts[0] == "projects":
        return parts[1]
    return ""


def load_all_notes(root: Path, topic_filter: str | None = None) -> list[FileMeta]:
    metas: list[FileMeta] = []
    base = root / "topics" / topic_filter if topic_filter else root / "topics"
    if not base.is_dir():
        return metas
    for dirpath, dirnames, filenames in os.walk(base, followlinks=True):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            p = Path(dirpath) / fn
            rel = p.relative_to(root).as_posix()
            if _is_infra(rel):
                continue
            try:
                text = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            fm, body = parse_frontmatter(text)
            tags_raw = fm.get("tags", [])
            if isinstance(tags_raw, str):
                tags_raw = [tags_raw]
            tags = [t.strip().strip('"').strip("'").lower() for t in tags_raw if t]
            fm_topic = str(fm.get("topic", "")).strip()
            inferred_topic = _topic_from_path(rel)
            topic = fm_topic or inferred_topic
            metas.append(FileMeta(
                path=p,
                rel=rel,
                topic=topic,
                fm_topic=fm_topic,
                tags=tags,
                note_type=str(fm.get("type", "")).strip(),
                body=body,
            ))
    return metas


# ---------------------------------------------------------------------------
# Topic tag profiles
# ---------------------------------------------------------------------------

def build_topic_profiles(root: Path, all_notes: list[FileMeta]) -> dict[str, set[str]]:
    """Map topic_slug → set of all tags seen across _summary.md + all notes."""
    profiles: dict[str, set[str]] = defaultdict(set)

    # Pull tags from _summary.md for each topic
    topics_dir = root / "topics"
    if topics_dir.is_dir():
        for t_dir in topics_dir.iterdir():
            if not t_dir.is_dir() or t_dir.name.startswith("."):
                continue
            summary = t_dir / "_summary.md"
            if summary.is_file():
                try:
                    text = summary.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                fm, _ = parse_frontmatter(text)
                tags_raw = fm.get("tags", [])
                if isinstance(tags_raw, str):
                    tags_raw = [tags_raw]
                for tag in tags_raw:
                    profiles[t_dir.name].add(tag.strip().strip('"').strip("'").lower())

    # Pool tags from all notes in each topic
    for note in all_notes:
        if note.topic:
            profiles[note.topic].update(note.tags)

    return dict(profiles)


def compute_idf(profiles: dict[str, set[str]]) -> dict[str, float]:
    """Inverse document frequency per tag across topics.
    IDF(tag) = log(N / df(tag) + 1), where N = number of topics."""
    n = len(profiles)
    df: dict[str, int] = defaultdict(int)
    for tags in profiles.values():
        for tag in tags:
            df[tag] += 1
    return {tag: math.log(n / (count + 1) + 1) for tag, count in df.items()}


# ---------------------------------------------------------------------------
# Forward mode: tag-based mismatch detection
# ---------------------------------------------------------------------------

@dataclass
class ForwardCandidate:
    note_rel: str
    current_topic: str
    suggested_topic: str
    current_score: float
    suggested_score: float
    gap: float
    shared_tags: list[str]      # tags matched in suggested topic
    home_tags: list[str]        # tags matched in current topic


def run_forward(
    all_notes: list[FileMeta],
    profiles: dict[str, set[str]],
    idf: dict[str, float],
    threshold: float,
    min_hits: int,
) -> list[ForwardCandidate]:
    candidates: list[ForwardCandidate] = []

    for note in all_notes:
        if not note.topic or not note.tags:
            continue
        # Only score notes that live inside a topic
        if not note.rel.startswith("topics/"):
            continue

        home_topic = note.topic
        scores: dict[str, float] = {}
        hits: dict[str, list[str]] = {}

        for topic, profile in profiles.items():
            matched = [t for t in note.tags if t in profile]
            score = sum(idf.get(t, 0.0) for t in matched)
            scores[topic] = score
            hits[topic] = matched

        home_score = scores.get(home_topic, 0.0)

        # Find top-scoring foreign topic
        best_foreign_topic = None
        best_foreign_score = -1.0
        for topic, score in scores.items():
            if topic == home_topic:
                continue
            if score > best_foreign_score:
                best_foreign_score = score
                best_foreign_topic = topic

        if best_foreign_topic is None:
            continue

        gap = best_foreign_score - home_score
        if gap < threshold:
            continue
        if len(hits.get(best_foreign_topic, [])) < min_hits:
            continue

        candidates.append(ForwardCandidate(
            note_rel=note.rel,
            current_topic=home_topic,
            suggested_topic=best_foreign_topic,
            current_score=round(home_score, 3),
            suggested_score=round(best_foreign_score, 3),
            gap=round(gap, 3),
            shared_tags=hits.get(best_foreign_topic, []),
            home_tags=hits.get(home_topic, []),
        ))

    candidates.sort(key=lambda c: c.gap, reverse=True)
    return candidates


# ---------------------------------------------------------------------------
# Reverse mode: inbound cross-topic link analysis
# ---------------------------------------------------------------------------

@dataclass
class ReverseCandidate:
    note_rel: str
    home_topic: str
    dominant_linker_topic: str
    cross_link_count: int
    home_link_count: int
    total_links: int
    cross_ratio: float   # cross_link_count / total_links
    example_linkers: list[str]


def build_inbound_index(all_notes: list[FileMeta]) -> dict[str, list[FileMeta]]:
    """For each note (by stem), collect all notes that wikilink to it.
    Each source note is counted once per target, even if it links multiple times."""
    inbound: dict[str, list[FileMeta]] = defaultdict(list)
    # Track (target_stem, source_rel) pairs to deduplicate
    seen: set[tuple[str, str]] = set()

    for source in all_notes:
        body_clean = strip_code(source.body)
        for match in WIKILINK_RE.finditer(body_clean):
            target = match.group(1).strip().split("#")[0].rstrip("\\").rstrip("/")
            if not target or target.startswith("{"):
                continue
            if target.endswith(".md"):
                target = target[:-3]
            stem = target.split("/")[-1].lower()
            key = (stem, source.rel)
            if key in seen:
                continue
            seen.add(key)
            inbound[stem].append(source)

    return dict(inbound)


def run_reverse(
    all_notes: list[FileMeta],
    min_links: int,
) -> list[ReverseCandidate]:
    inbound_idx = build_inbound_index(all_notes)
    note_by_stem: dict[str, FileMeta] = {}
    for note in all_notes:
        stem = note.path.stem.lower()
        note_by_stem[stem] = note

    candidates: list[ReverseCandidate] = []

    for note in all_notes:
        if not note.topic or not note.rel.startswith("topics/"):
            continue
        stem = note.path.stem.lower()
        linkers = inbound_idx.get(stem, [])
        if len(linkers) < min_links:
            continue

        # Count inbound links by topic
        topic_counts: dict[str, int] = defaultdict(int)
        topic_examples: dict[str, list[str]] = defaultdict(list)
        for linker in linkers:
            if linker.topic:
                topic_counts[linker.topic] += 1
                if len(topic_examples[linker.topic]) < 3:
                    topic_examples[linker.topic].append(linker.rel)

        total = len(linkers)
        home_count = topic_counts.get(note.topic, 0)
        cross_counts = {t: c for t, c in topic_counts.items() if t != note.topic}
        if not cross_counts:
            continue

        dominant_foreign = max(cross_counts, key=lambda t: cross_counts[t])
        dominant_count = cross_counts[dominant_foreign]

        # Flag if dominant foreign topic has more links than home topic
        # and meets minimum count
        if dominant_count <= home_count:
            continue
        if dominant_count < min_links:
            continue

        candidates.append(ReverseCandidate(
            note_rel=note.rel,
            home_topic=note.topic,
            dominant_linker_topic=dominant_foreign,
            cross_link_count=dominant_count,
            home_link_count=home_count,
            total_links=total,
            cross_ratio=round(dominant_count / total, 2),
            example_linkers=topic_examples[dominant_foreign],
        ))

    candidates.sort(key=lambda c: c.cross_ratio, reverse=True)
    return candidates


# ---------------------------------------------------------------------------
# Output formatters
# ---------------------------------------------------------------------------

def render_text(
    forward: list[ForwardCandidate] | None,
    reverse: list[ReverseCandidate] | None,
    kb_root: str,
    total_notes: int,
    total_topics: int,
) -> str:
    lines = [
        "# KB Topic Audit",
        f"KB: {kb_root}",
        f"Notes scanned: {total_notes}  |  Topics: {total_topics}",
        "",
    ]

    if forward is not None:
        lines.append(f"## Forward Pass — Tag Mismatch ({len(forward)} candidates)")
        lines.append("")
        if not forward:
            lines.append("No candidates found.")
        else:
            lines.append(
                f"{'Note':<55} {'Current':<22} {'Suggested':<22} {'Gap':>6}  Shared tags"
            )
            lines.append("-" * 130)
            for c in forward:
                note_short = c.note_rel.replace("topics/", "").replace("/notes/", " › ")
                tags_str = ", ".join(c.shared_tags[:4])
                if len(c.shared_tags) > 4:
                    tags_str += f" +{len(c.shared_tags)-4}"
                lines.append(
                    f"{note_short:<55} {c.current_topic:<22} {c.suggested_topic:<22} {c.gap:>+6.2f}  [{tags_str}]"
                )
                if c.home_tags:
                    lines.append(f"  {'':55} home matched tags: [{', '.join(c.home_tags[:4])}]")
        lines.append("")

    if reverse is not None:
        lines.append(f"## Reverse Pass — Cross-Topic Inbound Links ({len(reverse)} candidates)")
        lines.append("")
        if not reverse:
            lines.append("No candidates found.")
        else:
            lines.append(
                f"{'Note':<55} {'Home':<22} {'Dominant linker':<22} {'X-links':>8}  {'Home-links':>10}  Ratio"
            )
            lines.append("-" * 130)
            for c in reverse:
                note_short = c.note_rel.replace("topics/", "").replace("/notes/", " › ")
                lines.append(
                    f"{note_short:<55} {c.home_topic:<22} {c.dominant_linker_topic:<22} "
                    f"{c.cross_link_count:>8}  {c.home_link_count:>10}  {c.cross_ratio:.0%}"
                )
                for ex in c.example_linkers[:2]:
                    ex_short = ex.replace("topics/", "t/")
                    lines.append(f"  {'':55} ← {ex_short}")
        lines.append("")

    total_candidates = (len(forward) if forward else 0) + (len(reverse) if reverse else 0)
    lines.append(f"Total candidates: {total_candidates}")
    return "\n".join(lines)


def render_md(
    forward: list[ForwardCandidate] | None,
    reverse: list[ReverseCandidate] | None,
    kb_root: str,
    total_notes: int,
    total_topics: int,
) -> str:
    lines = [
        "# KB Topic Audit",
        f"**KB:** `{kb_root}`  \n**Notes scanned:** {total_notes} | **Topics:** {total_topics}",
        "",
    ]

    if forward is not None:
        lines.append(f"## Forward Pass — Tag Mismatch ({len(forward)} candidates)")
        lines.append("")
        if not forward:
            lines.append("*No candidates found.*")
        else:
            lines.append("| Note | Current | Suggested | Gap | Shared tags |")
            lines.append("|---|---|---|---|---|")
            for c in forward:
                note_short = c.note_rel.replace("topics/", "").replace("/notes/concepts/", "/").replace("/notes/entities/", "/")
                tags_str = ", ".join(f"`{t}`" for t in c.shared_tags[:5])
                lines.append(f"| `{note_short}` | {c.current_topic} | **{c.suggested_topic}** | +{c.gap:.2f} | {tags_str} |")
        lines.append("")

    if reverse is not None:
        lines.append(f"## Reverse Pass — Cross-Topic Inbound Links ({len(reverse)} candidates)")
        lines.append("")
        if not reverse:
            lines.append("*No candidates found.*")
        else:
            lines.append("| Note | Home | Dominant linker | Cross-links | Home links | Ratio |")
            lines.append("|---|---|---|---|---|---|")
            for c in reverse:
                note_short = c.note_rel.replace("topics/", "").replace("/notes/concepts/", "/").replace("/notes/entities/", "/")
                lines.append(
                    f"| `{note_short}` | {c.home_topic} | **{c.dominant_linker_topic}** | "
                    f"{c.cross_link_count} | {c.home_link_count} | {c.cross_ratio:.0%} |"
                )
        lines.append("")

    return "\n".join(lines)


def render_json_out(
    forward: list[ForwardCandidate] | None,
    reverse: list[ReverseCandidate] | None,
    kb_root: str,
    total_notes: int,
    total_topics: int,
) -> str:
    payload: dict = {
        "kb_root": kb_root,
        "notes_scanned": total_notes,
        "topics": total_topics,
    }
    if forward is not None:
        payload["forward"] = [asdict(c) for c in forward]
    if reverse is not None:
        payload["reverse"] = [asdict(c) for c in reverse]
    return json.dumps(payload, indent=2)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--forward", action="store_true", help="forward pass only")
    mode.add_argument("--reverse", action="store_true", help="reverse pass only")

    p.add_argument("--topic", metavar="SLUG", help="restrict to one topic")
    p.add_argument("--min-hits", type=int, default=1, metavar="N",
                   help="min matching tags to flag in forward mode (default 1)")
    p.add_argument("--threshold", type=float, default=0.2, metavar="F",
                   help="min IDF score gap to flag in forward mode (default 0.2)")
    p.add_argument("--min-links", type=int, default=2, metavar="N",
                   help="min cross-topic inbound links for reverse mode (default 2)")

    fmt = p.add_mutually_exclusive_group()
    fmt.add_argument("--json", action="store_true")
    fmt.add_argument("--md", action="store_true")

    args = p.parse_args()

    do_forward = args.forward or (not args.forward and not args.reverse)
    do_reverse = args.reverse or (not args.forward and not args.reverse)

    root = resolve_kb_root()
    if not root.is_dir():
        print(f"kb-topic-audit: KB root not found: {root}", file=sys.stderr)
        return 2

    all_notes = load_all_notes(root, args.topic)
    if not all_notes:
        print("kb-topic-audit: no notes found.", file=sys.stderr)
        return 0

    # Build profiles from all topics (not scoped, even if --topic is set,
    # so scoring is always against the full topic taxonomy)
    all_notes_full = load_all_notes(root) if args.topic else all_notes
    profiles = build_topic_profiles(root, all_notes_full)
    idf = compute_idf(profiles)

    topics_dir = root / "topics"
    total_topics = sum(1 for t in topics_dir.iterdir() if t.is_dir() and not t.name.startswith(".")) if topics_dir.is_dir() else 0

    forward_results: list[ForwardCandidate] | None = None
    reverse_results: list[ReverseCandidate] | None = None

    if do_forward:
        forward_results = run_forward(all_notes, profiles, idf, args.threshold, args.min_hits)

    if do_reverse:
        reverse_results = run_reverse(all_notes, args.min_links)

    kb_root_str = str(root)
    total_notes = len(all_notes)

    if args.json:
        print(render_json_out(forward_results, reverse_results, kb_root_str, total_notes, total_topics))
    elif args.md:
        print(render_md(forward_results, reverse_results, kb_root_str, total_notes, total_topics))
    else:
        print(render_text(forward_results, reverse_results, kb_root_str, total_notes, total_topics))

    total = (len(forward_results) if forward_results else 0) + (len(reverse_results) if reverse_results else 0)
    return 1 if total > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
