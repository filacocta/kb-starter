#!/usr/bin/env python3
"""kb-index — build and update a frontmatter cache for the Obsidian KB.

Writes `_kb-index.json` at the KB root. Each record contains path, type,
topic, title, description, tags, status, and modified date — enough to
navigate the KB without reading individual files.

Usage:
  kb-index           rebuild full cache (default)
  kb-index --update  explicitly refresh all metadata
  kb-index --stats   print summary statistics

Exit codes:
  0 = success
  2 = error (KB not found)
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from kb_config import (  # noqa: E402
    KBConfigError,
    atomic_write_text,
    iter_markdown,
    read_regular_text,
    resolve_kb_root,
)

# ---------------------------------------------------------------------------
INDEX_FILE = "_kb-index.json"

SKIP_NAMES = {
    "_index.md", "_checkpoint.md", "_schema.md", "_rules.md",
    "_dive-queue.md", "_todo.md", "_log.md", "_relink-report.md",
    "_workflow-checklist.md", "_no-emojis.md", "_kb-index.json",
    "reading-list.md", "LINKS.md", "README.md",
}
SKIP_DIRS = {".obsidian", ".git", ".trash", "bases", "sources"}
SKIP_PREFIXES = ("topics/personal-notes/notes/daily/",)

FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.DOTALL)
SIMPLE_FIELD_RE = re.compile(r"^([\w-]+):\s*(.+)$", re.MULTILINE)


def is_skipped(path: Path, kb_root: Path) -> bool:
    rel = str(path.relative_to(kb_root))
    parts = Path(rel).parts
    if any(p in SKIP_DIRS for p in parts):
        return True
    if path.name in SKIP_NAMES or path.name.startswith("_"):
        return True
    if path.suffix == ".base":
        return True
    if any(rel.startswith(p) for p in SKIP_PREFIXES):
        return True
    return False


def parse_frontmatter(text: str) -> dict:
    m = FRONTMATTER_RE.match(text)
    if not m:
        return {}
    raw = m.group(1)
    try:
        fm = yaml.safe_load(raw) or {}
        if isinstance(fm, dict):
            return fm
    except yaml.YAMLError:
        pass
    # Fallback: simple regex for scalar fields
    fm = {}
    for km in SIMPLE_FIELD_RE.finditer(raw):
        key, val = km.group(1), km.group(2).strip().strip('"').strip("'")
        if key in ("type", "topic", "title", "description", "entity-type",
                   "status", "created", "modified", "updated"):
            fm[key] = val
    return fm


def extract_tags(fm: dict) -> list[str]:
    raw = fm.get("tags")
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(t) for t in raw if t]
    if isinstance(raw, str):
        return [t.strip() for t in raw.replace(",", " ").split() if t.strip()]
    return []


def extract_description(fm: dict, body: str) -> str:
    """Get description: frontmatter field, or first non-heading sentence."""
    desc = fm.get("description", "")
    if desc:
        return str(desc).strip()[:300]
    # Fall back to first non-empty, non-heading line of body
    for line in body.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and not line.startswith("---"):
            return line[:300]
    return ""


def derive_topic(fm: dict, path: Path, kb_root: Path) -> str:
    topic = str(fm.get("topic", "")).strip()
    if topic:
        return topic
    parts = path.relative_to(kb_root).parts
    if len(parts) >= 2 and parts[0] in ("topics", "projects"):
        return parts[1]
    return ""


def build_record(path: Path, kb_root: Path) -> dict | None:
    if is_skipped(path, kb_root):
        return None
    try:
        mtime_s = path.stat().st_mtime
        text = read_regular_text(path)
    except (KBConfigError, OSError):
        return None

    m = FRONTMATTER_RE.match(text)
    body = text[m.end():] if m else text
    fm = parse_frontmatter(text)

    if not fm and not text.startswith("---"):
        return None  # no frontmatter at all — not a KB note

    rel = str(path.relative_to(kb_root))

    return {
        "path": rel,
        "type": str(fm.get("type", "")).strip(),
        "topic": derive_topic(fm, path, kb_root),
        "title": str(fm.get("title", path.stem.replace("-", " ").title())).strip(),
        "description": extract_description(fm, body),
        "tags": extract_tags(fm),
        "status": str(fm.get("status", "")).strip(),
        "modified": str(fm.get("modified", fm.get("updated", ""))).strip(),
        "mtime": mtime_s,
        "is_stub": "This is a stub" in body,
    }


def build_index(kb_root: Path) -> list[dict]:
    records = []
    scanned = 0
    for path in iter_markdown(kb_root, ("topics", "projects")):
        scanned += 1
        record = build_record(path, kb_root)
        if record:
            records.append(record)
    print(f"Scanned {scanned} files, indexed {len(records)} notes", file=sys.stderr)
    return records


def print_stats(records: list[dict]) -> None:
    by_type: dict[str, int] = {}
    by_topic: dict[str, int] = {}
    stubs = sum(1 for r in records if r.get("is_stub"))
    untagged = sum(1 for r in records if not r.get("tags"))

    for r in records:
        t = r.get("type") or "unknown"
        by_type[t] = by_type.get(t, 0) + 1
        tp = r.get("topic") or "unknown"
        by_topic[tp] = by_topic.get(tp, 0) + 1

    print(f"\nKB Index Statistics")
    print(f"  Total records:  {len(records)}")
    print(f"  Stubs:          {stubs}")
    print(f"  Untagged:       {untagged}")
    print(f"\nBy type:")
    for t, n in sorted(by_type.items(), key=lambda x: -x[1]):
        print(f"  {t:20s} {n}")
    print(f"\nTop topics:")
    for tp, n in sorted(by_topic.items(), key=lambda x: -x[1])[:15]:
        print(f"  {tp:35s} {n}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--update", action="store_true",
                        help="Refresh all metadata; preserved as an alias for explicit rebuilding")
    parser.add_argument("--stats", action="store_true",
                        help="Print summary statistics after building")
    parser.add_argument("--kb-root", default=None)
    args = parser.parse_args()

    try:
        kb_root = resolve_kb_root(args.kb_root)
    except KBConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    try:
        records = build_index(kb_root)
    except (KBConfigError, OSError) as exc:
        print(f"error: cannot scan KB: {exc}", file=sys.stderr)
        return 2
    records.sort(key=lambda r: r["path"])

    # Write cache
    index_path = kb_root / INDEX_FILE
    out = {
        "built": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "kb_root": str(kb_root),
        "count": len(records),
        "records": records,
    }
    try:
        atomic_write_text(index_path, json.dumps(out, indent=1, ensure_ascii=False))
    except (KBConfigError, OSError) as exc:
        print(f"error: cannot write index: {exc}", file=sys.stderr)
        return 2
    print(f"Wrote {index_path} ({index_path.stat().st_size // 1024} KB)")

    if args.stats:
        print_stats(records)

    return 0


if __name__ == "__main__":
    sys.exit(main())
