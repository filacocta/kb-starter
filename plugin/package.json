{
	"name": "kb-bot",
	"version": "1.0.0",
	"description": "A knowledge base bot plugin for Obsidian, powered by Claude.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test tests/api.test.ts tests/guard.test.ts tests/ingest.test.ts tests/topics.test.ts",
		"test:watch": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test --watch tests/api.test.ts tests/guard.test.ts tests/ingest.test.ts tests/topics.test.ts",
		"lint": "eslint . --ext .js,.ts"
	},
	"keywords": ["obsidian", "plugin"],
	"author": "markr",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^25.5.0",
		"@typescript-eslint/parser": "^8.58.0",
		"esbuild": "0.27.4",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"expect": "^30.3.0",
		"globals": "^17.4.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"tsx": "^4.21.0",
		"typescript": "6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}
