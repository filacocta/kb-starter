TELEGRAM_BOT_TOKEN=
# Optional: command used for weekly Claude digest/reply review.
# The default auto-discovers `claude` and runs it in plan-mode with read/write/fetch tools denied.
# Override only if systemd cannot find agent CLI or you want a different model/flags.
# KB_FEED_CLAUDE_CMD=claude -p --permission-mode plan --disallowedTools Bash,Edit,Glob,Grep,LS,MultiEdit,NotebookEdit,NotebookRead,Read,Task,TodoWrite,WebFetch,WebSearch,Write --disable-slash-commands --strict-mcp-config --mcp-config '{"mcpServers":{}}' --no-session-persistence
# Optional: only required for `kb-feed triage` commands.
DEEPSEEK_API_KEY=
# Optional overrides — defaults target DeepSeek v4 Flash at https://api.deepseek.com.
KB_FEED_LLM_PROVIDER=deepseek
KB_FEED_LLM_API_BASE=https://api.deepseek.com
KB_FEED_LLM_MODEL=deepseek-v4-flash
KB_FEED_LLM_API_KEY=
KB_FEED_LLM_TIMEOUT=60
