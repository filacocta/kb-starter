[Unit]
Description=kb-feed delayed LLM triage of unfiltered Telegram links
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Vault/projects/kb-feed
EnvironmentFile=%h/.config/kb-feed/credentials.env
ExecStart=%h/Vault/projects/kb-feed/.venv/bin/kb-feed triage links --state-db %h/.local/state/kb-feed/state.sqlite --kb-root %h/Vault/knowledgebase --inactivity-hours 2
SuccessExitStatus=2
