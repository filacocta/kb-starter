[Unit]
Description=kb-feed Telegram polling daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Vault/projects/kb-feed
EnvironmentFile=%h/.config/kb-feed/credentials.env
ExecStart=%h/Vault/projects/kb-feed/.venv/bin/kb-feed poll --config %h/.config/kb-feed/kb-feed.toml --state-db %h/.local/state/kb-feed/state.sqlite
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
