[Unit]
Description=kb-feed snoozed digest reminder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Vault/projects/kb-feed
EnvironmentFile=%h/.config/kb-feed/credentials.env
ExecStart=%h/Vault/projects/kb-feed/.venv/bin/kb-feed digest remind --state-db %h/.local/state/kb-feed/state.sqlite --send-telegram
