[Unit]
Description=kb-feed flush queued Telegram items into the live KB
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Vault/projects/kb-feed
ExecStart=%h/Vault/projects/kb-feed/.venv/bin/kb-feed outbox flush --state-db %h/.local/state/kb-feed/state.sqlite --kb-root %h/Vault/knowledgebase --allow-live-kb --commit --commit-debounce-seconds 300 --commit-max-pending 20
